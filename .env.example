# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API (or "Connect").
# Never commit .env.local. Never put a service-role / secret key here.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...) — or, on older projects, the "anon" public key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site, used in confirmation and password-reset emails.
# http://localhost:3000 locally; your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
